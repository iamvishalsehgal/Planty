# Planty Backend Configuration
# Copy to .env and adjust

# Database (SQLite for dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:///planty.db

# App
PLANTY_TITLE=Planty v2
PLANTY_VERSION=2.0.0
PLANTY_DEBUG=false
PLANTY_LOG_LEVEL=INFO

# Rate limiting (requests per second per IP)
PLANTY_RATE_LIMIT=10

# Health recompute interval (minutes)
PLANTY_HEALTH_INTERVAL=5

# CORS origins (comma-separated)
PLANTY_CORS_ORIGINS=*

# Weather default coordinates (Amsterdam)
PLANTY_WEATHER_LAT=52.3676
PLANTY_WEATHER_LON=4.9041
